# Interview Shala API — copy to apps/api/.env

APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_shala

CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
# Defaults to the origin of CLERK_JWKS_URL when omitted.
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
# Optional:
# CLERK_AUDIENCE=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud

GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

ENCRYPTION_KEY=
ANONYMOUS_SESSION_SECRET=change-me-in-production
ANONYMOUS_SESSION_TTL_DAYS=30

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
